<!DOCTYPE html>
<html><head><link rel="stylesheet" href="/css/style.css"></head>
<body class="auth-page">
    <div class="auth-card">
        <h2>Login to Butler</h2>
        <form action="/auth/login" method="POST">
            <input type="email" name="email" placeholder="Email" required value="admin@butler.local">
            <input type="password" name="password" placeholder="Password" required value="password">
            <button type="submit">Enter Workspace</button>
        </form>
    </div>
</body></html>