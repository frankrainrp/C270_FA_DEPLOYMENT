<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="theme-light">
  <%- include('../partials/topbar') %>
  <main class="container">

    <div class="page-head">
      <h1 data-i18n="settingsTitle">Settings & Billing</h1>
      <p data-i18n="settingsSubtitle">Manage your plan, credits, and preferences.</p>
    </div>

    <!-- Credits -->
    <div class="card">
      <h3 data-i18n="aiCredits">AI Credits</h3>
      <div class="credit-display">
        <span class="num"><%= user.credits %></span>
        <span class="label" data-i18n="creditsRemaining">credits remaining</span>
      </div>
      <p class="sub" style="margin-top:0.75rem;"><span data-i18n="plan">Plan:</span> <span class="plan-badge"><%= user.plan %></span></p>
      <form action="/billing/use-credit" method="POST" style="margin-top:0.5rem;">
        <button type="submit" class="btn btn-ghost" data-i18n="useCredits">Use 10 credits (test)</button>
      </form>
    </div>

    <!-- AI Usage & Safety -->
    <div class="card">
      <h3 data-i18n="usageSafety">AI Usage &amp; Safety</h3>
      <p class="sub" data-i18n="usageSafetyDesc">Keep track of your AI usage and stay in control.</p>

      <div class="usage-row">
        <div class="usage-stat">
          <span class="usage-num"><%= usage.messagesThisMonth %></span>
          <span class="usage-label" data-i18n="messagesMonth">messages this month</span>
        </div>
        <div class="usage-stat">
          <span class="usage-num"><%= usage.creditsUsedThisMonth %></span>
          <span class="usage-label" data-i18n="creditsMonth">credits used this month</span>
        </div>
      </div>

      <div class="toggle-row">
        <div>
          <strong data-i18n="safetyFilterTitle">Content safety filter</strong>
          <p class="sub" style="margin:0;" data-i18n="safetyFilterDesc">Blocks unsafe or inappropriate AI responses.</p>
        </div>
        <label class="switch">
          <input type="checkbox" id="safetyFilter" checked>
          <span class="slider"></span>
        </label>
      </div>

      <div class="toggle-row">
        <div>
          <strong data-i18n="usageReminderTitle">Daily usage reminder</strong>
          <p class="sub" style="margin:0;" data-i18n="usageReminderDesc">Reminds you after heavy AI use to take a break.</p>
        </div>
        <label class="switch">
          <input type="checkbox" id="usageReminder">
          <span class="slider"></span>
        </label>
      </div>

      <div class="toggle-row">
        <div>
          <strong data-i18n="improveAITitle">Use my chats to improve AI</strong>
          <p class="sub" style="margin:0;" data-i18n="improveAIDesc">Turn off to keep your conversations private.</p>
        </div>
        <label class="switch">
          <input type="checkbox" id="improveAI" checked>
          <span class="slider"></span>
        </label>
      </div>

      <p class="sub" id="safetySaved" style="margin-top:0.5rem; color: green; display:none;" data-i18n="saved">Saved ✓</p>
    </div>

    <!-- Membership -->
    <div class="card">
      <h3 data-i18n="membership">Membership</h3>
      <p class="sub" data-i18n="membershipDesc">Upgrade for more credits and faster AI.</p>
      <a href="/billing/plans" class="btn btn-primary" data-i18n="viewPlans">View plans & upgrade</a>
    </div>

    <!-- Account -->
    <div class="card">
      <h3 data-i18n="account">Account</h3>
      <p class="sub" data-i18n="accountDesc">Update your account details.</p>
      <form action="/billing/account" method="POST">
        <div class="field">
          <label for="accName" data-i18n="name">Name</label>
          <input type="text" id="accName" name="name" value="<%= user.name %>">
        </div>
        <div class="field">
          <label for="accEmail" data-i18n="email">Email</label>
          <input type="email" id="accEmail" name="email" value="<%= user.email %>">
        </div>
        <div class="field">
          <label for="accPassword" data-i18n="newPassword">New password</label>
          <input type="password" id="accPassword" name="password" placeholder="••••••••">
          <p class="sub" style="margin:0.25rem 0 0;" data-i18n="passwordSimulated">Password change is simulated for now.</p>
        </div>
        <button type="submit" class="btn btn-primary" data-i18n="saveChanges">Save changes</button>
      </form>
    </div>

    <!-- Preferences -->
    <div class="card">
      <h3 data-i18n="preferences">Preferences</h3>
      <div class="field">
        <label for="languageSelect" data-i18n="language">Language</label>
        <select id="languageSelect">
          <option value="en">English</option>
          <option value="zh">中文 (Chinese)</option>
        </select>
      </div>
      <div class="field">
        <label for="themeSelect" data-i18n="theme">Theme</label>
        <select id="themeSelect">
          <option value="light" data-i18n="light">Light</option>
          <option value="dark" data-i18n="dark">Dark</option>
        </select>
      </div>
      <p class="sub" id="prefSaved" style="margin-top:0.5rem; color: green; display:none;" data-i18n="saved">Saved ✓</p>
    </div>

  </main>

  <!-- Translations dictionary -->
  <script>
    var translations = {
      en: {
        settingsTitle: "Settings & Billing",
        settingsSubtitle: "Manage your plan, credits, and preferences.",
        aiCredits: "AI Credits",
        creditsRemaining: "credits remaining",
        plan: "Plan:",
        useCredits: "Use 10 credits (test)",
        usageSafety: "AI Usage & Safety",
        usageSafetyDesc: "Keep track of your AI usage and stay in control.",
        messagesMonth: "messages this month",
        creditsMonth: "credits used this month",
        safetyFilterTitle: "Content safety filter",
        safetyFilterDesc: "Blocks unsafe or inappropriate AI responses.",
        usageReminderTitle: "Daily usage reminder",
        usageReminderDesc: "Reminds you after heavy AI use to take a break.",
        improveAITitle: "Use my chats to improve AI",
        improveAIDesc: "Turn off to keep your conversations private.",
        membership: "Membership",
        membershipDesc: "Upgrade for more credits and faster AI.",
        viewPlans: "View plans & upgrade",
        account: "Account",
        accountDesc: "Update your account details.",
        name: "Name",
        email: "Email",
        newPassword: "New password",
        passwordSimulated: "Password change is simulated for now.",
        saveChanges: "Save changes",
        preferences: "Preferences",
        language: "Language",
        theme: "Theme",
        light: "Light",
        dark: "Dark",
        saved: "Saved ✓"
      },
      zh: {
        settingsTitle: "设置与账单",
        settingsSubtitle: "管理您的套餐、点数和偏好设置。",
        aiCredits: "AI 点数",
        creditsRemaining: "剩余点数",
        plan: "套餐：",
        useCredits: "使用 10 点数（测试）",
        usageSafety: "AI 使用与安全",
        usageSafetyDesc: "追踪您的 AI 使用情况，保持掌控。",
        messagesMonth: "本月消息数",
        creditsMonth: "本月已用点数",
        safetyFilterTitle: "内容安全过滤",
        safetyFilterDesc: "拦截不安全或不当的 AI 回复。",
        usageReminderTitle: "每日使用提醒",
        usageReminderDesc: "在您大量使用 AI 后提醒您休息。",
        improveAITitle: "使用我的对话改进 AI",
        improveAIDesc: "关闭以保护您的对话隐私。",
        membership: "会员",
        membershipDesc: "升级以获得更多点数和更快的 AI。",
        viewPlans: "查看套餐并升级",
        account: "账户",
        accountDesc: "更新您的账户信息。",
        name: "姓名",
        email: "电子邮件",
        newPassword: "新密码",
        passwordSimulated: "密码更改目前为模拟功能。",
        saveChanges: "保存更改",
        preferences: "偏好设置",
        language: "语言",
        theme: "主题",
        light: "浅色",
        dark: "深色",
        saved: "已保存 ✓"
      }
    };

    function applyLanguage(lang) {
      var dict = translations[lang] || translations.en;
      document.querySelectorAll('[data-i18n]').forEach(function (el) {
        var key = el.getAttribute('data-i18n');
        if (dict[key]) el.textContent = dict[key];
      });
    }
  </script>

  <!-- Preferences logic: theme + language -->
  <script>
    (function () {
      var themeSelect = document.getElementById('themeSelect');
      var languageSelect = document.getElementById('languageSelect');
      var savedMsg = document.getElementById('prefSaved');

      themeSelect.value = localStorage.getItem('butler-theme') || 'light';
      languageSelect.value = localStorage.getItem('butler-language') || 'en';

      // Apply saved language on page load
      applyLanguage(languageSelect.value);

      function showSaved() {
        savedMsg.style.display = 'block';
        setTimeout(function () { savedMsg.style.display = 'none'; }, 1500);
      }

      themeSelect.addEventListener('change', function () {
        var choice = themeSelect.value;
        document.documentElement.setAttribute('data-theme', choice);
        localStorage.setItem('butler-theme', choice);
        showSaved();
      });

      languageSelect.addEventListener('change', function () {
        var choice = languageSelect.value;
        localStorage.setItem('butler-language', choice);
        applyLanguage(choice);
        showSaved();
      });
    })();
  </script>

  <!-- AI safety toggles -->
  <script>
    (function () {
      var toggles = ['safetyFilter', 'usageReminder', 'improveAI'];
      var savedMsg = document.getElementById('safetySaved');

      toggles.forEach(function (id) {
        var saved = localStorage.getItem('butler-' + id);
        if (saved !== null) document.getElementById(id).checked = (saved === 'true');
      });

      function showSaved() {
        savedMsg.style.display = 'block';
        setTimeout(function () { savedMsg.style.display = 'none'; }, 1500);
      }

      toggles.forEach(function (id) {
        document.getElementById(id).addEventListener('change', function () {
          localStorage.setItem('butler-' + id, this.checked);
          showSaved();
        });
      });
    })();
  </script>
</body>
</html>