<%
  /*
    partials/_task-card.ejs
    Renders a single task card.
    Expects `t` (task object) to be passed in.
    Assumes `fmtDue` (function) and `priorityColor` (object) are in scope.
  */
  const dueLabel = fmtDue(t.dueDate);
  const description = t.description || "";
%>
<article
  class="task-card <%= t.status === 'completed' ? 'completed' : '' %>"
  data-task-id="<%= t._id %>"
  data-task-completed="<%= t.status === 'completed' %>"
  data-task-due-date="<%= t.dueDate ? new Date(t.dueDate).toISOString() : '' %>"
  data-title="<%= t.title %>"
  data-due="<%= dueLabel %>"
  data-priority="<%= t.priority || 'medium' %>"
  data-description="<%= description %>"
  data-notes="<%= t.notes || '' %>"
  style="--task-color: <%= priorityColor[t.priority] || priorityColor.medium %>"
>
  <input
    class="task-checkbox"
    type="checkbox"
    <%= t.status === "completed" ? "checked" : "" %>
    data-task-toggle
    aria-label="Toggle complete"
  />
  <div class="task-main">
    <div class="task-title"><%= t.title %></div>
    <div class="task-meta">
      <span>Due <%= dueLabel %></span>
      <span>Priority: <%= t.priority || 'medium' %></span>
    </div>
  </div>
  <div class="task-actions">
    <button class="glass-btn task-edit-trigger" type="button" data-task-edit>Edit</button>
    <button class="glass-btn" type="button" data-task-delete>Delete</button>
  </div>
</article>