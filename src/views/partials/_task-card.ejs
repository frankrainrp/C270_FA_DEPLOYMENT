<%
  /*
    partials/_task-card.ejs
    Renders a single task card.
    Expects `t` (task object) to be passed in.
    Assumes `fmtDue` (function) and `priorityColor` (object) are in scope.
  */
  const dueLabel = fmtDue(t.dueDate);
  const description = t.description || "";
  const isEvent = Boolean(t.isEvent);
  const status = t.status || (t.completed ? "completed" : "active");
%>
<article
  class="task-card <%= status === 'completed' ? 'completed' : '' %> <%= isEvent ? 'task-card-event' : '' %>"
  draggable="<%= isEvent ? 'false' : 'true' %>"
  data-task-id="<%= t._id %>"
  data-task-completed="<%= status === 'completed' %>"
  data-task-status="<%= status %>"
  data-item-type="<%= isEvent ? 'event' : 'task' %>"
  data-task-due-date="<%= t.dueDate ? new Date(t.dueDate).toISOString() : '' %>"
  data-title="<%= t.title %>"
  data-due="<%= dueLabel %>"
  data-priority="<%= t.priority || 'medium' %>"
  data-description="<%= description %>"
  data-notes="<%= t.notes || '' %>"
  style="--task-color: <%= priorityColor[t.priority] || priorityColor.medium %>"
>
  <% if (isEvent) { %>
    <span class="task-event-mark calendar-icon" aria-hidden="true"></span>
  <% } else { %>
    <input
      class="task-checkbox"
      type="checkbox"
      <%= status === "completed" ? "checked" : "" %>
      data-task-toggle
      aria-label="Toggle complete"
    />
  <% } %>
  <div class="task-main">
    <div class="task-title">
      <%= t.title %>
      <% if (isEvent) { %><span class="task-type-badge">Calendar event</span><% } %>
    </div>
    <div class="task-meta">
      <span>Due <%= dueLabel %></span>
      <% if (!isEvent) { %><span>Priority: <%= t.priority || 'medium' %></span><% } %>
    </div>
  </div>
  <div class="task-actions">
    <button class="glass-btn task-edit-trigger" type="button" data-task-edit>Edit</button>
    <button class="glass-btn" type="button" data-task-delete>Delete</button>
  </div>
</article>
