<header class="topbar">
  <div class="logo">🎩 Butler</div>
  <nav class="nav-links">
    <a href="/study/dashboard">Tasks & Calendar</a>
    <a href="/ai/chat">AI Agent</a>
    <a href="/panels/connectors">Data Panels</a>

    <!-- Account dropdown -->
    <div class="account" onclick="toggleAccountMenu()">
      <div class="account-avatar">
        <%= (typeof user !== 'undefined' && user.name) ? user.name.charAt(0) : 'U' %>
      </div>
      <div class="account-info">
        <span class="account-name"><%= (typeof user !== 'undefined' && user.name) ? user.name : 'Account' %></span>
        <span class="account-plan"><%= (typeof user !== 'undefined' && user.plan) ? user.plan : '' %></span>
      </div>
      <span class="account-caret">▾</span>

      <div class="account-menu" id="accountMenu">
        <a href="/billing/profile">👤 Profile</a>
        <a href="/billing/settings">⚙️ Settings</a>
        <a href="/billing/plans">✨ Upgrade plan</a>
        <div class="account-menu-divider"></div>
        <a href="/auth/logout" class="logout">↩ Log out</a>
      </div>
    </div>
  </nav>
</header>

<script>
  // Apply the saved theme on every page that includes the topbar
  (function () {
    var savedTheme = localStorage.getItem('butler-theme') || 'light';
    document.documentElement.setAttribute('data-theme', savedTheme);
  })();

  function toggleAccountMenu() {
    document.getElementById('accountMenu').classList.toggle('open');
  }
  // close the menu when clicking outside it
  document.addEventListener('click', function (e) {
    var acc = document.querySelector('.account');
    var menu = document.getElementById('accountMenu');
    if (acc && menu && !acc.contains(e.target)) menu.classList.remove('open');
  });
</script>