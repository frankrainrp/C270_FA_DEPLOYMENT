<%
  /*
    layout.ejs
    Master page shell.  Mirrors the C270_FA React composition:
    WallpaperLayer + TopBar + LeftRail + main panel + MobileTabBar.

    Locals accepted (populated by lib/renderLayout.js):
    - title               : page title
    - theme               : paper | dark | retro
    - activeNav           : chat | tasks | calendar | notes
    - activeCustomPanelId : currently selected custom panel id
    - tabsOrder           : ordered list of built-in tab ids
    - hiddenTabs          : list of built-in tab ids to hide
    - customPanels        : [{ id, label, emoji }]
    - authProfile         : { name, email, imageUrl }
    - plan                : free | pro | max
    - planName            : display name shown in the user menu
    - rail                : sidebar data forwarded to partials/sidebar.ejs
    - page                : file under views/pages/ to include as main content
    - pageLocals          : extra locals forwarded to the page partial
    - labels              : optional string dictionary
    - t                   : optional translation function
  */
  const value = (name, fallback) => (
    typeof locals !== "undefined" && Object.prototype.hasOwnProperty.call(locals, name)
      ? locals[name]
      : fallback
  );

  const labels = value("labels", {});
  const label = (key, fallback) => {
    if (typeof t === "function") return t(key);
    return Object.prototype.hasOwnProperty.call(labels, key) ? labels[key] : fallback;
  };

  const pageTitle = value("title", "Butler");
  const theme = value("theme", "paper");
  const activeNav = value("activeNav", "chat");
  const activeCustomPanelId = value("activeCustomPanelId", null);
  const navDefaults = ["chat", "tasks", "calendar", "notes"];
  const tabsOrder = Array.isArray(value("tabsOrder", null)) ? value("tabsOrder") : navDefaults;
  const hiddenTabs = new Set(value("hiddenTabs", []));
  const visibleTabs = tabsOrder.filter((id) => !hiddenTabs.has(id));
  const customPanels = Array.isArray(value("customPanels", [])) ? value("customPanels", []) : [];
  const authProfile = value("authProfile", {});
  const userName = authProfile.name || label("user.name", "Student User");
  const userEmail = authProfile.email || label("user.email", "student@example.com");
  const userImageUrl = authProfile.imageUrl || "";
  const plan = value("plan", "free");
  const planName = value("planName", plan === "max" ? "Max" : plan === "pro" ? "Pro" : "Free");
  const isPaid = plan !== "free";
  const rail = value("rail", {});
  const page = value("page", null);
  const pageLocals = value("pageLocals", {});
%>
<!doctype html>
<html lang="<%= value("lang", "en") %>" data-theme="<%= theme %>">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="data:," />
    <meta name="theme-color" content="#f3eee0" />
    <title><%= pageTitle %></title>
    <script>
      // Applies the user's saved theme BEFORE stylesheet loads, so
      // there is no flash of the wrong theme.  Must stay inline and
      // must precede the CSS <link>.
      (function () {
        try {
          var saved = localStorage.getItem("butler-theme");
          if (saved === "paper" || saved === "retro" || saved === "dark") {
            document.documentElement.setAttribute("data-theme", saved);
          }
        } catch (_) { /* localStorage unavailable */ }
      })();
    </script>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="layout-shell" data-layout-shell>
      <div class="layout-wallpaper" aria-hidden="true">
        <div class="wallpaper-grid"></div>
        <div class="wallpaper-glow"></div>
        <div class="wallpaper-halftone"></div>
      </div>

      <header class="layout-topbar glass-panel" data-topbar>
        <a class="topbar-brand" href="/" aria-label="Butler home">
          <span class="app-logo" aria-hidden="true"></span>
          <span class="brand-name">Butler</span>
        </a>

        <nav class="pill-nav" aria-label="<%= label("topbar.mainNavigation", "Main navigation") %>">
          <% visibleTabs.forEach((id) => { %>
            <a
              class="pill-nav-item <%= !activeCustomPanelId && activeNav === id ? "active" : "" %>"
              href="/<%= id %>"
              data-nav-id="<%= id %>"
              data-draggable-tab="true"
              title="<%= label("topbar.tabReorder", "Drag to reorder") %>"
            >
              <span><%= label("nav." + id, id.charAt(0).toUpperCase() + id.slice(1)) %></span>
            </a>
          <% }) %>

          <% customPanels.forEach((panel) => { %>
            <a
              class="pill-nav-item custom <%= activeCustomPanelId === panel.id ? "active" : "" %>"
              href="/panel/<%= panel.id %>"
              data-custom-panel-id="<%= panel.id %>"
              title="<%= panel.label || label("nav.customPanel", "Custom panel") %>"
            >
              <span class="pill-nav-emoji" aria-hidden="true"><%= panel.emoji || "P" %></span>
              <span class="pill-nav-label"><%= panel.label || label("nav.customPanel", "Custom panel") %></span>
            </a>
          <% }) %>
        </nav>

        <div class="topbar-actions">
          <form
              class="global-search"
              role="search"
              action="/search"
              method="GET"
              data-global-search
          >

              <label class="sr-only" for="global-search-input">
                  <%= label("search.label", "Search") %>
              </label>

              <button
                  type="submit"
                  class="search-submit"
                  aria-label="Search"
              >
                  <span class="search-icon" aria-hidden="true"></span>
              </button>

              <input
                  id="global-search-input"
                  name="q"
                  type="search"
                  autocomplete="off"
                  spellcheck="false"
                  placeholder="Search anything..."
                  value="<%= value("searchQuery", "") %>"
              />

          </form>

          <button
            class="icon-button"
            type="button"
            data-action="toggle-mini-apps"
            aria-pressed="<%= value("miniAppsOpen", false) ? "true" : "false" %>"
            aria-label="<%= label("topbar.miniApps", "Mini apps") %>"
            title="<%= label("topbar.miniApps", "Mini apps") %>"
          >
            <span class="icon-grid" aria-hidden="true"></span>
          </button>

          <div class="user-menu-wrap" data-user-menu>
            <button
              class="user-trigger"
              type="button"
              data-user-menu-trigger
              aria-haspopup="menu"
              aria-expanded="false"
            >
              <span class="avatar">
                <% if (userImageUrl) { %>
                  <img src="<%= userImageUrl %>" alt="" />
                <% } else { %>
                  <span class="avatar-fallback" aria-hidden="true"><%= userName.slice(0, 1).toUpperCase() %></span>
                <% } %>
              </span>
              <span class="user-summary">
                <span class="user-name"><%= userName %></span>
                <span class="user-email"><%= userEmail %></span>
              </span>
              <span class="chevron" aria-hidden="true"></span>
            </button>

            <div class="user-menu glass-menu" role="menu" data-user-menu-panel hidden>
              <div class="user-menu-header">
                <span class="avatar large">
                  <% if (userImageUrl) { %>
                    <img src="<%= userImageUrl %>" alt="" />
                  <% } else { %>
                    <span class="avatar-fallback" aria-hidden="true"><%= userName.slice(0, 1).toUpperCase() %></span>
                  <% } %>
                </span>
                <div>
                  <strong><%= userName %></strong>
                  <span><%= userEmail %></span>
                  <em class="plan-badge <%= isPaid ? "paid" : "free" %>"><%= planName %></em>
                </div>
              </div>

              <a role="menuitem" class="menu-item" href="/billing">
                <span class="menu-icon card-icon" aria-hidden="true"></span>
                <span><%= label("menu.billing", "Billing") %></span>
              </a>
              <a role="menuitem" class="menu-item" href="/preferences">
                <span class="menu-icon settings-icon" aria-hidden="true"></span>
                <span><%= label("menu.preferences", "Preferences") %></span>
              </a>
              <a role="menuitem" class="menu-item" href="/achievements">
                <span class="menu-icon trophy-icon" aria-hidden="true"></span>
                <span><%= label("menu.achievements", "Achievements") %></span>
              </a>
              <% if (!isPaid) { %>
                <a role="menuitem" class="menu-item accent" href="/pricing">
                  <span class="menu-icon crown-icon" aria-hidden="true"></span>
                  <span><%= label("menu.upgrade", "Upgrade") %></span>
                </a>
              <% } %>
              <form role="none" action="/logout" method="post">
                <button role="menuitem" class="menu-item danger" type="submit">
                  <span class="menu-icon logout-icon" aria-hidden="true"></span>
                  <span><%= label("menu.logout", "Log out") %></span>
                </button>
              </form>
            </div>
          </div>
        </div>
      </header>

      <div class="mini-apps-drawer" data-mini-apps-panel hidden>
        <div class="mini-app-header">
          <div>
            <p class="mini-app-label">Learning tools</p>
            <p class="mini-app-subtitle">Focus timer, study analytics, and share cards</p>
          </div>
          <button class="icon-button mini-app-close" type="button" data-close-mini-apps aria-label="Close learning tools">×</button>
        </div>

        <div class="mini-app-tabs">
          <button type="button" class="mini-app-tab mini-app-tab-active" data-tab="focus">Focus on timing</button>
          <button type="button" class="mini-app-tab" data-tab="stats">Learning Statistics</button>
          <button type="button" class="mini-app-tab" data-tab="share">Share Card</button>
        </div>

        <div class="mini-app-panel" data-panel="focus">
          <div class="focus-timer-panel">
            <div class="focus-timer-circle">
              <span class="focus-timer-label">FOCUS TIMER</span>
              <strong class="focus-timer-time">25:00</strong>
              <span class="focus-timer-state">Ready to begin</span>
            </div>

            <div class="focus-timer-actions">
              <button class="glass-btn focus-timer-play" type="button">Start</button>
              <button class="glass-btn focus-timer-reset" type="button">Reset</button>
            </div>

            <div class="focus-timer-presets">
              <button class="glass-btn glass-btn-secondary" type="button" data-preset="25">25 min</button>
              <button class="glass-btn glass-btn-secondary" type="button" data-preset="45">45 min</button>
              <button class="glass-btn glass-btn-secondary" type="button" data-preset="60">60 min</button>
            </div>
          </div>
        </div>

        <div class="mini-app-panel" data-panel="stats" hidden>
          <div class="learning-stats-panel">
            <div class="learning-stats-grid">
              <div class="learning-stat-card stat-success">
                <span>Completed</span>
                <strong data-stat-completed>0</strong>
              </div>
              <div class="learning-stat-card stat-warning">
                <span>In progress</span>
                <strong data-stat-active>0</strong>
              </div>
            </div>
            <div class="learning-stats-grid">
              <div class="learning-stat-card stat-info">
                <span>Upcoming</span>
                <strong data-stat-upcoming>0</strong>
              </div>
              <div class="learning-stat-card stat-neutral">
                <span>Study goal</span>
                <strong>Keep focus strong</strong>
              </div>
            </div>
            <div class="weekly-trend">
              <div class="weekly-trend-header">
                <span>7-day completion trend</span>
                <strong class="weekly-trend-count" data-weekly-total>0 completed</strong>
              </div>
              <div class="weekly-trend-bars" data-weekly-bars></div>
              <div class="weekly-trend-labels" data-weekly-labels></div>
              <div class="weekly-trend-note" data-weekly-note></div>
            </div>
            <div class="tag-distribution">
              <div class="tag-distribution-label">Task tag distribution</div>
              <div class="tag-list" data-tag-list>
                <span class="tag-empty">No tags yet. Add #tags to tasks to see distribution here.</span>
              </div>
            </div>
          </div>
        </div>

        <div class="mini-app-panel" data-panel="share" hidden>
          <div class="share-card-shell">
            <div class="share-card-header">
              <div>
                <div class="share-card-label">Butler • Study Summary</div>
                <div class="share-card-date" data-share-date></div>
              </div>
              <div class="share-card-badge">B</div>
            </div>
            <div class="share-card-summary" data-share-summary>
              Today I have completed 0 tasks and I’m working on 0 more.
            </div>
            <div class="share-card-metrics">
              <div>
                <span>Completed</span>
                <strong data-share-completed>0</strong>
              </div>
              <div>
                <span>In progress</span>
                <strong data-share-active>0</strong>
              </div>
              <div>
                <span>Upcoming</span>
                <strong data-share-upcoming>0</strong>
              </div>
            </div>
          </div>
          <button class="glass-btn share-copy-button" type="button" data-share-copy>Copy share text</button>
          <textarea class="share-card-text" data-share-text readonly></textarea>
        </div>

        <p class="mini-app-footer">Progress data is loaded from your current tasks.</p>
      </div>

      <div class="layout-body">
        <button
          class="mobile-drawer-backdrop"
          type="button"
          data-mobile-drawer-backdrop
          aria-label="<%= label("topbar.closeNav", "Close navigation") %>"
          hidden
        ></button>

        <aside class="layout-sidebar glass-panel retro-railhost" data-mobile-drawer>
          <%- include("./partials/sidebar", { activeNav, activeCustomPanelId, rail, label }) %>
        </aside>

        <main class="layout-main glass-panel" id="main-content" tabindex="-1">
          <% if (page) { %>
            <%- include("./pages/" + page, Object.assign({ activeNav, rail, label }, pageLocals || {})) %>
          <% } %>
        </main>
      </div>

      <nav class="mobile-tabbar glass-panel" aria-label="<%= label("topbar.mobileNavigation", "Mobile navigation") %>">
        <button class="mobile-tabbar-menu" type="button" data-mobile-drawer-trigger aria-label="<%= label("topbar.openNav", "Open navigation") %>">
          <span class="panel-icon" aria-hidden="true"></span>
        </button>

        <% navDefaults.forEach((id) => { %>
          <a
            class="mobile-tab <%= !activeCustomPanelId && activeNav === id ? "active" : "" %>"
            href="/<%= id %>"
            data-nav-id="<%= id %>"
            aria-label="<%= label("nav." + id, id.charAt(0).toUpperCase() + id.slice(1)) %>"
          >
            <span class="mobile-tab-icon <%= "icon-" + id %>" aria-hidden="true"></span>
            <span><%= label("nav." + id, id.charAt(0).toUpperCase() + id.slice(1)) %></span>
          </a>
        <% }) %>
      </nav>
    </div>

    <script src="/js/api.js" defer></script>
    <script src="/js/shell.js" defer></script>
  </body>
</html>
