<%
  /*
    pages/note.ejs
    Notes workspace: split list + editor.
    Static skeleton for the UI shell phase; wired to /api/notes later.
  */
  const demoNotes = [
    { id: "n1", title: "DevOps CA2 spec",         preview: "Butler must combine tasks, calendar, notes, and AI chat..." },
    { id: "n2", title: "React → EJS mapping",     preview: "ChatCanvas.tsx maps to pages/chat.ejs + chat-ui.js..." },
    { id: "n3", title: "Ideas for the data panel", preview: "Small charts, generated by AI, saved as custom panels..." },
  ];

  const active = demoNotes[0];
%>

<section class="notes-panel">
  <aside class="notes-list">
    <header class="notes-list-header">
      <strong>Notes</strong>
      <input
        class="auth-input-wrap"
        style="height: 34px;"
        type="search"
        placeholder="Search notes"
        aria-label="Search notes"
      />
    </header>

    <% demoNotes.forEach(function(n, i) { %>
      <a class="note-list-item <%= i === 0 ? 'active' : '' %>" href="#<%= n.id %>">
        <strong><%= n.title %></strong>
        <p><%= n.preview %></p>
      </a>
    <% }) %>
  </aside>

  <article class="note-editor">
    <div class="note-editor-toolbar">
      <input
        class="note-title-input"
        type="text"
        value="<%= active.title %>"
        aria-label="Note title"
      />
      <button class="glass-btn" type="button">Save</button>
    </div>
    <textarea
      class="note-body-input"
      aria-label="Note body"
    ># <%= active.title %>

<%= active.preview %>

- Written in markdown.
- Rendered as an Obsidian-style preview in later phases.
</textarea>
  </article>
</section>
