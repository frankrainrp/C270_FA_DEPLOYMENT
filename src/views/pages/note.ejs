<%
  /*
    pages/note.ejs
    Notes workspace: list on the left, editor on the right.
    Data is loaded server-side by pages.js from MongoDB.

    Locals available (via pageLocals):
    - notes : Array of Note documents (POJOs from .toObject())
  */
  const list = Array.isArray(locals.notes) ? locals.notes : [];
  const active = list[0] || { _id: "", title: "", content: "" };

  function previewOf(n) {
    const body = String((n && n.content) || "").trim();
    if (!body) return "(empty)";
    return body.length > 120 ? body.slice(0, 120) + "…" : body;
  }
%>

<section class="notes-panel" data-notes-root>
  <aside class="notes-list" data-notes-list>
    <header class="notes-list-header">
      <strong>Notes (<%= list.length %>)</strong>
      <button class="glass-btn glass-btn-primary" type="button" data-new-note>New</button>
    </header>

    <% if (list.length === 0) { %>
      <div style="padding: 20px; color: var(--color-text-muted);">
        No notes yet.  Click <strong>New</strong>, or ask Butler in
        <a href="/chat">chat</a>.
      </div>
    <% } %>

    <% list.forEach(function(n, i) { %>
      <a
        class="note-list-item <%= i === 0 ? 'active' : '' %>"
        href="#<%= n._id %>"
        data-note-id="<%= n._id %>"
      >
        <strong><%= n.title %><% if (n.pinned) { %> ★<% } %></strong>
        <p><%= previewOf(n) %></p>
      </a>
    <% }) %>
  </aside>

  <article
    class="note-editor"
    data-note-editor
    data-note-id="<%= active._id || '' %>"
  >
    <div class="note-editor-toolbar">
      <input
        class="note-title-input"
        type="text"
        value="<%= active.title || '' %>"
        placeholder="Untitled note"
        aria-label="Note title"
        data-note-title
      />
      <button class="glass-btn glass-btn-primary" type="button" data-note-save>Save</button>
      <button class="glass-btn" type="button" data-note-delete>Delete</button>
    </div>
    <textarea
      class="note-body-input"
      aria-label="Note body"
      placeholder="Write in markdown..."
      data-note-body
    ><%= active.content || "" %></textarea>
  </article>
</section>

<script src="/js/api.js" defer></script>
<script src="/js/notes-ui.js" defer></script>
