<%
  /*
    pages/note.ejs
    Notes workspace. Renders the note list + editor from server data
    (locals.notes / locals.activeNote, supplied by routes/pages.js).
    Interactions (select, search, save, create, delete) live in notes.js.
  */
  const noteList = Array.isArray(locals.notes) ? locals.notes : [];
  const active = locals.activeNote || noteList[0] ||
    { id: "", title: "", body: "", preview: "", updated: "just now" };
  const hasNotes = noteList.length > 0;
%>

<section class="notes-panel" data-notes-root>
  <aside class="notes-list">
    <header class="notes-list-header">
      <div class="notes-summary">
        <strong>Notes</strong>
        <p>Capture ideas, keep them searchable, and revisit them later.</p>
      </div>
      <input
        id="note-search"
        class="auth-input-wrap"
        style="height: 34px;"
        type="search"
        placeholder="Search notes"
        aria-label="Search notes"
      />
    </header>

    <div data-notes-listbox>
      <% noteList.forEach(function (note) { %>
        <button
          class="note-list-item <%= note.id === active.id ? 'active' : '' %>"
          type="button"
          data-note-id="<%= note.id %>"
          data-note-title="<%= note.title %>"
          data-note-preview="<%= note.preview %>"
          data-note-body="<%= note.body %>"
          data-note-updated="<%= note.updated %>"
        >
          <strong><%= note.title %></strong>
          <p><%= note.preview %></p>
        </button>
      <% }) %>
    </div>

    <p class="notes-empty" data-notes-empty <%= hasNotes ? "hidden" : "" %>>
      No notes yet. Use “New Note” to create one.
    </p>
  </aside>

  <article class="note-editor" data-note-editor <%= hasNotes ? "" : "hidden" %>>
    <div class="note-editor-toolbar">
      <div>
        <p class="hero-kicker">Study note</p>
        <input
          id="note-title-input"
          class="note-title-input"
          type="text"
          value="<%= active.title %>"
          aria-label="Note title"
        />
      </div>
      <div class="note-editor-actions">
        <button id="delete-note-btn" class="glass-btn" type="button">Delete</button>
        <button id="save-note-btn" class="glass-btn glass-btn-primary" type="button">Save</button>
      </div>
    </div>
    <div class="note-editor-meta">
      <span id="note-updated-label">Updated <%= active.updated %></span>
      <span class="drawer-pill">Markdown</span>
    </div>
    <textarea
      id="note-body-input"
      class="note-body-input"
      aria-label="Note body"
    ><%= active.body %></textarea>
    <input type="hidden" id="note-active-id" value="<%= active.id %>" />
  </article>
</section>

<script src="/js/api.js" defer></script>
<script src="/js/notes.js" defer></script>
