<%
  /*
    pages/task.ejs
    Renders the Tasks workspace from SERVER data (see routes/pages.js):
      - locals.tasks     : the tasks for the currently selected view
      - locals.view      : the active view key (active|in_progress|upcoming|all|completed)
      - locals.viewLabel : human label for that view ("Active", "In Progress", ...)

    HOW THE PIECES CONNECT (study note):
      sidebar.ejs  -> each "Views" item links to /tasks?view=KEY
      pages.js     -> reads ?view=, asks tasksStore for the matching tasks
      task.ejs     -> (this file) just displays whatever list it is handed
    So the task list is NOT hardcoded here anymore — it lives in
    data/tasksStore.js, which is what makes Views + New Task actually work.
  */
  const tasks = Array.isArray(locals.tasks) ? locals.tasks : [];
  const viewLabel = locals.viewLabel || "Tasks";

  // Each priority maps to a colour used as the card's left accent bar.
  const priorityColor = {
    high: "var(--color-danger)",
    medium: "var(--color-warning)",
    low: "var(--color-primary)",
  };
%>

<section class="tasks-panel">
  <header class="chat-composer" style="border-top: 0; border-bottom: 1px solid var(--color-border-soft); padding: 14px 22px;">
    <strong style="font-family: var(--font-display); font-size: 20px;">Tasks</strong>
    <span style="color: var(--color-text-muted); margin-left: 8px;">Study productivity workspace</span>
  </header>

  <div class="tasks-content">
    <div class="task-group">
      <!-- Heading shows the current view name and how many tasks it holds. -->
      <div class="task-group-title">
        <span><%= viewLabel %></span>
        <span><%= tasks.length %></span>
      </div>

      <% if (tasks.length === 0) { %>
        <!-- Empty state: shown when the selected view has no tasks. -->
        <p class="tasks-empty">No tasks in this view yet.</p>
      <% } %>

      <% tasks.forEach(function (task) { %>
        <article
          class="task-card <%= task.status === "completed" ? "completed" : "" %>"
          data-task-id="<%= task.id %>"
          data-title="<%= task.title %>"
          data-due="<%= task.due %>"
          data-priority="<%= task.priority %>"
          data-description="<%= task.description %>"
          data-notes="<%= task.notes %>"
          style="--task-color: <%= priorityColor[task.priority] || "var(--color-primary)" %>"
        >
          <input
            class="task-checkbox"
            type="checkbox"
            <%= task.status === "completed" ? "checked" : "" %>
            aria-label="Toggle complete"
          />
          <div class="task-main">
            <div class="task-title"><%= task.title %></div>
            <div class="task-meta">
              <span>Due <%= task.due %></span>
              <span>Priority: <%= task.priority %></span>
            </div>
          </div>
          <div class="task-actions">
            <button class="glass-btn task-detail-trigger" type="button">Details</button>
          </div>
        </article>
      <% }) %>
    </div>
  </div>

  <!--
    Slide-in detail drawer.  It starts with the [hidden] attribute; when a
    card's "Details" button is clicked, shell.js copies that card's data-*
    values into these fields and removes [hidden] to reveal the drawer.
  -->
  <div class="task-detail-drawer" id="task-detail-drawer" hidden>
    <div class="task-drawer-header">
      <div>
        <p class="hero-kicker">Task detail</p>
        <h3 id="task-detail-title">Select a task</h3>
      </div>
      <button class="glass-btn" type="button" data-close-drawer>Close</button>
    </div>
    <div class="task-drawer-body">
      <div class="drawer-meta-row">
        <span class="drawer-pill" id="task-detail-priority">Priority</span>
        <span class="drawer-pill" id="task-detail-due">Due</span>
      </div>
      <p id="task-detail-description" class="drawer-description">Pick a task card to open its detail view.</p>
      <div class="drawer-section">
        <h4>Study notes</h4>
        <p id="task-detail-notes">No notes yet.</p>
      </div>
      <div class="drawer-section">
        <h4>Suggested next step</h4>
        <p>Break this task into one small action and keep the momentum going.</p>
      </div>
    </div>
  </div>
</section>
