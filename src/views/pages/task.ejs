<%
  /*
    pages/task.ejs
    Study productivity task workspace. Filters live in the contextual rail;
    task and calendar-event data comes from MongoDB via pages.js.
  */
  const list = Array.isArray(locals.tasks) ? locals.tasks : [];
  const selectedView = locals.taskView || (rail && rail.taskView) || "all";
  const priorityColor = {
    high: "var(--color-danger)",
    medium: "var(--color-warning)",
    low: "var(--color-primary)"
  };

  function fmtDue(d) {
    if (!d) return "No due date";
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const dt = new Date(d);
    if (isNaN(dt.getTime())) return "";
    dt.setHours(0, 0, 0, 0);
    const diff = Math.round((dt - today) / (1000 * 60 * 60 * 24));
    if (diff === 0)  return "Today";
    if (diff === 1)  return "Tomorrow";
    if (diff === -1) return "Yesterday";
    if (diff > 1 && diff <= 7) return "In " + diff + " days";
    if (diff < 0)    return Math.abs(diff) + " days ago";
    return dt.toISOString().slice(0, 10);
  }

  const today = new Date();
  today.setHours(0, 0, 0, 0);

  const isCompleted = (t) => t.status === "completed" || t.completed === true;
  const isUpcoming = (t) => {
    const due = t.dueDate ? new Date(t.dueDate) : null;
    return !isCompleted(t) && due && !isNaN(due.getTime()) && due >= today;
  };
  const completedTasks = list.filter(isCompleted);
  const allProgressTasks = list.filter((t) => !isCompleted(t) && t.status === "in_progress");
  const allActiveTasks = list.filter((t) =>
    !isCompleted(t) && (t.status === "active" || (!t.status && !t.completed))
  );
  const allUpcomingTasks = list.filter(isUpcoming);

  // "All" uses mutually exclusive groups. A focused rail view follows the
  // view's full meaning, so Active includes future active tasks and Upcoming
  // includes in-progress work that is due in the future.
  const activeTasks = selectedView === "active"
    ? allActiveTasks
    : allActiveTasks.filter((t) => !isUpcoming(t));
  const progressTasks = allProgressTasks;
  const upcomingTasks = selectedView === "upcoming"
    ? allUpcomingTasks
    : allUpcomingTasks.filter((t) => t.status !== "in_progress");

  const visibleGroup = (name) => selectedView === "all" || selectedView === name;
%>
<style>
  .tasks-workspace-layout {
    display: block;
    padding: 24px 32px;
  }

  .tasks-content {
    max-height: calc(100vh - 380px);
    overflow-y: auto;
    padding: 0 12px 28px 0;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }
  
  .tasks-content::-webkit-scrollbar {
    width: 8px;
  }
  .tasks-content::-webkit-scrollbar-thumb {
    background: var(--color-border-soft);
    border-radius: 999px;
  }
  .tasks-content::-webkit-scrollbar-track {
    background: transparent;
  }
  
  @media (max-width: 860px) {
    .tasks-workspace-layout {
      padding: 16px;
    }
    .tasks-content {
      max-height: 65vh;
    }
  }
</style>

<section class="tasks-panel" data-tasks-root>
  <header
    class="chat-composer"
    style="border-top: 0; border-bottom: 1px solid var(--color-border-soft); padding: 14px 22px; display: flex; align-items: center; justify-content: space-between;"
  >
    <div>
      <strong style="font-family: var(--font-display); font-size: 20px;">Tasks</strong>
      <span style="color: var(--color-text-muted); margin-left: 8px;">Study productivity workspace</span>
    </div>
    <div>
      <button class="glass-btn" type="button" data-action="new-task">New Task</button>
      <button class="glass-btn" type="button" data-refresh-tasks>Refresh</button>
    </div>
  </header>

  <div class="productivity-hero">
    <div class="hero-card hero-main">
      <p class="hero-kicker">Daily overview</p>
      <h3>Keep the study sprint moving with a calm, focused plan.</h3>
      <div class="hero-stats">
        <div>
          <strong><%= allActiveTasks.length %></strong>
          <span>Active</span>
        </div>
        <div>
          <strong><%= progressTasks.length %></strong>
          <span>In Progress</span>
        </div>
        <div>
          <strong><%= allUpcomingTasks.length %></strong>
          <span>Upcoming</span>
        </div>
        <div>
          <strong><%= completedTasks.length %></strong>
          <span>Completed</span>
        </div>
        <div>
          <strong><%= list.length %></strong>
          <span>Total</span>
        </div>
      </div>
    </div>
  </div>

  <div class="tasks-workspace-layout">
    <!-- Main Tasks List -->
    <div class="tasks-content" data-tasks-list>
      
      <% if (list.length === 0) { %>
        <div style="padding: 40px; text-align: center; color: var(--color-text-muted);">
          <p>No tasks yet.</p>
          <p>Click <strong>New Task</strong> to add one, or ask Butler in <a href="/chat">chat</a>.</p>
        </div>
      <% } %>

      <!-- ACTIVE GROUP -->
      <div class="task-group" data-task-group="active" <%= visibleGroup("active") ? "" : "hidden" %>>
        <div class="task-group-title">
          <span>Active</span>
          <span><%= activeTasks.length %></span>
        </div>
        <% if (activeTasks.length === 0) { %>
          <p style="color: var(--color-text-muted); font-size: 13px; padding: 10px;">No active tasks.</p>
        <% } else { %>
          <% activeTasks.forEach(function(t) { %>
            <%- include("../partials/_task-card", { t, fmtDue, priorityColor }) %>
          <% }) %>
        <% } %>
      </div>

      <!-- IN PROGRESS GROUP -->
      <div class="task-group" data-task-group="in_progress" <%= visibleGroup("in_progress") ? "" : "hidden" %>>
        <div class="task-group-title">
          <span>In Progress</span>
          <span><%= progressTasks.length %></span>
        </div>
        <% if (progressTasks.length === 0) { %>
          <p style="color: var(--color-text-muted); font-size: 13px; padding: 10px;">No tasks in progress.</p>
        <% } else { %>
          <% progressTasks.forEach(function(t) { %>
            <%- include("../partials/_task-card", { t, fmtDue, priorityColor }) %>
          <% }) %>
        <% } %>
      </div>

      <!-- UPCOMING GROUP -->
      <div class="task-group" data-task-group="upcoming" <%= visibleGroup("upcoming") ? "" : "hidden" %>>
        <div class="task-group-title">
          <span>Upcoming</span>
          <span><%= upcomingTasks.length %></span>
        </div>
        <% if (upcomingTasks.length === 0) { %>
          <p style="color: var(--color-text-muted); font-size: 13px; padding: 10px;">No upcoming tasks.</p>
        <% } else { %>
          <% upcomingTasks.forEach(function(t) { %>
            <%- include("../partials/_task-card", { t, fmtDue, priorityColor }) %>
          <% }) %>
        <% } %>
      </div>

      <!-- COMPLETED GROUP -->
      <div class="task-group" data-task-group="completed" <%= visibleGroup("completed") ? "" : "hidden" %>>
        <div class="task-group-title">
          <span>Completed</span>
          <span><%= completedTasks.length %></span>
        </div>
        <% if (completedTasks.length === 0) { %>
          <p style="color: var(--color-text-muted); font-size: 13px; padding: 10px;">No completed tasks yet.</p>
        <% } else { %>
          <% completedTasks.forEach(function(t) { %>
            <%- include("../partials/_task-card", { t, fmtDue, priorityColor }) %>
          <% }) %>
        <% } %>
      </div>

    </div>
  </div>
</section>

<script src="/js/api.js" defer></script>
<script src="/js/tasks-ui.js" defer></script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const params = new URLSearchParams(window.location.search);
    const highlightId = params.get("highlight");
    if (!highlightId) return;
    const card = document.querySelector('[data-task-id="' + highlightId + '"]');
    if (!card) return;
    card.scrollIntoView({ behavior: "smooth", block: "center" });
    card.style.outline = "2px solid var(--accent, #6fbf73)";
    card.style.outlineOffset = "2px";
    setTimeout(() => {
      card.style.outline = "";
      card.style.outlineOffset = "";
    }, 2000);
  });
</script>
