<%
  /*
    pages/task.ejs
    Study productivity task workspace with overview cards, task list,
    and a detail drawer.  Task data comes from MongoDB via pages.js.
  */
  const list = Array.isArray(locals.tasks) ? locals.tasks : [];

  const priorityColor = {
    high: "var(--color-danger)",
    medium: "var(--color-warning)",
    low: "var(--color-primary)"
  };

  function fmtDue(d) {
    if (!d) return "No due date";
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const dt = new Date(d);
    if (isNaN(dt.getTime())) return "";
    dt.setHours(0, 0, 0, 0);
    const diff = Math.round((dt - today) / (1000 * 60 * 60 * 24));
    if (diff === 0)  return "Today";
    if (diff === 1)  return "Tomorrow";
    if (diff === -1) return "Yesterday";
    if (diff > 1 && diff <= 7) return "In " + diff + " days";
    if (diff < 0)    return Math.abs(diff) + " days ago";
    return dt.toISOString().slice(0, 10);
  }

  const activeTasks = list.filter((t) => t.status === 'active');
  const progressTasks = list.filter((t) => t.status === 'in_progress');
  const upcomingTasks = list.filter((t) => t.status === 'upcoming');
  const completedTasks = list.filter((t) => t.status === 'completed');
%>

<section class="tasks-panel" data-tasks-root>
  <header
    class="chat-composer"
    style="border-top: 0; border-bottom: 1px solid var(--color-border-soft); padding: 14px 22px; display: flex; align-items: center; justify-content: space-between;"
  >
    <div>
      <strong style="font-family: var(--font-display); font-size: 20px;">Tasks</strong>
      <span style="color: var(--color-text-muted); margin-left: 8px;">Study productivity workspace</span>
      <span data-task-view-label style="color: var(--color-text-muted); margin-left: 8px; padding: 4px 10px; border: 1px solid var(--color-border-soft); border-radius: 999px; font-size: 12px;">Viewing <%= taskViewLabel %></span>
    </div>
    <div>
      <button class="glass-btn" type="button" data-open-new-task>New Task</button>
      <button class="glass-btn" type="button" data-refresh-tasks>Refresh</button>
    </div>
  </header>

  <div class="productivity-hero">
    <div class="hero-card hero-main">
      <p class="hero-kicker">Daily overview</p>
      <h3>Keep the study sprint moving with a calm, focused plan.</h3>
      <div class="hero-stats">
        <div>
          <strong><%= activeTasks.length %></strong>
          <span>Active</span>
        </div>
        <div>
          <strong><%= progressTasks.length %></strong>
          <span>In Progress</span>
        </div>
        <div>
          <strong><%= upcomingTasks.length %></strong>
          <span>Upcoming</span>
        </div>
        <div>
          <strong><%= completedTasks.length %></strong>
          <span>Completed</span>
        </div>
        <div>
          <strong><%= list.length %></strong>
          <span>Total</span>
        </div>
      </div>
    </div>

    <div class="hero-card">
      <p class="hero-kicker">Achievements</p>
      <ul class="chip-list">
        <li><%= completedTasks.length %> completed</li>
        <li><%= progressTasks.length %> in progress</li>
        <li><%= upcomingTasks.length %> upcoming</li>
        <li><%= activeTasks.length %> active</li>
        <li>Ask Butler to add more</li>
      </ul>
    </div>

    <div class="hero-card">
      <p class="hero-kicker">Focus tools</p>
      <div class="focus-tools">
        <span>Pomodoro 25:00</span>
        <span>Deep work</span>
        <span>Noise block</span>
      </div>
    </div>
  </div>

  <div class="tasks-content" data-tasks-list>
    <% if (list.length === 0) { %>
      <div style="padding: 40px; text-align: center; color: var(--color-text-muted);">
        <p>No tasks yet.</p>
        <p>Ask Butler in <a href="/chat">chat</a> to add one, e.g.
          <em>"Add a task: finish CA2 tomorrow, high priority"</em>.</p>
      </div>
    <% } %>

    <% if (activeTasks.length > 0) { %>
      <div class="task-group">
        <div class="task-group-title">
          <span>Active</span>
          <span><%= activeTasks.length %></span>
        </div>

        <% activeTasks.forEach(function(t) {
          const dueLabel = fmtDue(t.dueDate);
          const description = t.description || "";
          %>
          <article
            class="task-card"
            data-task-id="<%= t._id %>"
            data-task-completed="false"
            data-task-due-date="<%= t.dueDate ? new Date(t.dueDate).toISOString() : '' %>"
            data-title="<%= t.title %>"
            data-due="<%= dueLabel %>"
            data-priority="<%= t.priority || 'medium' %>"
            data-description="<%= description %>"
            data-notes="<%= description || 'No notes yet.' %>"
            style="--task-color: <%= priorityColor[t.priority] || priorityColor.medium %>"
          >
            <input
              class="task-checkbox"
              type="checkbox"
              <%= t.status === "completed" ? "checked" : "" %>
              data-task-toggle
              aria-label="Toggle complete"
            />
            <div class="task-main">
              <div class="task-title"><%= t.title %></div>
              <div class="task-meta">
                <span>Due <%= dueLabel %></span>
                <span>Priority: <%= t.priority || 'medium' %></span>
              </div>
            </div>
            <div class="task-actions">
              <button class="glass-btn task-edit-trigger" type="button" data-task-edit>Edit</button>
              <button class="glass-btn" type="button" data-task-delete>Delete</button>
            </div>
          </article>
        <% }) %>
      </div>
        <% } %>
    <% } %>

    <!-- =========================
         In Progress Tasks
    ========================== -->
    <% if (progressTasks.length > 0) { %>
      <div class="task-group">
        <div class="task-group-title">
          <span>In Progress</span>
          <span><%= progressTasks.length %></span>
        </div>

        <% progressTasks.forEach(function(t) {
          const dueLabel = fmtDue(t.dueDate);
          const description = t.description || "";
          %>

          <article
            class="task-card"
            data-task-id="<%= t._id %>"
            data-task-completed="false"
            data-task-due-date="<%= t.dueDate ? new Date(t.dueDate).toISOString() : '' %>"
            data-title="<%= t.title %>"
            data-due="<%= dueLabel %>"
            data-priority="<%= t.priority || 'medium' %>"
            data-description="<%= description %>"
            data-notes="<%= description || 'No notes yet.' %>"
            style="--task-color: <%= priorityColor[t.priority] || priorityColor.medium %>"
          >
            <input
              class="task-checkbox"
              type="checkbox"
              <%= t.status === "completed" ? "checked" : "" %>
              data-task-toggle
              aria-label="Toggle complete"
            />

            <div class="task-main">
              <div class="task-title"><%= t.title %></div>

              <div class="task-meta">
                <span>Due <%= dueLabel %></span>
                <span>Priority: <%= t.priority || 'medium' %></span>
              </div>
            </div>

            <div class="task-actions">
              <button class="glass-btn task-edit-trigger" type="button" data-task-edit>Edit</button>

              <button
                class="glass-btn"
                type="button"
                data-task-delete
              >
                Delete
              </button>
              <button class="glass-btn" type="button" data-task-delete>Delete</button>
            </div>
          </article>

        <% }) %>
      </div>
    <% } %>

    <!-- =========================
         Upcoming Tasks
    ========================== -->
    <% if (upcomingTasks.length > 0) { %>
      <div class="task-group">
        <div class="task-group-title">
          <span>Upcoming</span>
          <span><%= upcomingTasks.length %></span>
        </div>

        <% upcomingTasks.forEach(function(t) {
          const dueLabel = fmtDue(t.dueDate);
          const description = t.description || "";
          %>
          <article
            class="task-card"
            data-task-id="<%= t._id %>"
            data-task-completed="false"
            data-task-due-date="<%= t.dueDate ? new Date(t.dueDate).toISOString() : '' %>"
            data-title="<%= t.title %>"
            data-due="<%= dueLabel %>"
            data-priority="<%= t.priority || 'medium' %>"
            data-description="<%= description %>"
            data-notes="<%= description || 'No notes yet.' %>"
            style="--task-color: <%= priorityColor[t.priority] || priorityColor.medium %>"
          >
            <input
              class="task-checkbox"
              type="checkbox"
              <%= t.status === "completed" ? "checked" : "" %>
              data-task-toggle
              aria-label="Toggle complete"
            />
            <div class="task-main">
              <div class="task-title"><%= t.title %></div>
              <div class="task-meta">
                <span>Due <%= dueLabel %></span>
                <span>Priority: <%= t.priority || 'medium' %></span>
              </div>
            </div>
            <div class="task-actions">
              <button class="glass-btn task-edit-trigger" type="button" data-task-edit>Edit</button>
              <button class="glass-btn" type="button" data-task-delete>Delete</button>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>

    <!-- =========================
         Completed Tasks
    ========================== -->

    <% if (completedTasks.length > 0) { %>
      <div class="task-group">
        <div class="task-group-title">
          <span>Completed</span>
          <span><%= completedTasks.length %></span>
        </div>

        <% completedTasks.forEach(function(t) {
          const dueLabel = fmtDue(t.dueDate);
          const description = t.description || "";
          %>
          <article
            class="task-card completed"
            data-task-id="<%= t._id %>"
            data-task-completed="true"
            data-task-due-date="<%= t.dueDate ? new Date(t.dueDate).toISOString() : '' %>"
            data-title="<%= t.title %>"
            data-due="<%= dueLabel %>"
            data-priority="<%= t.priority || 'medium' %>"
            data-description="<%= description %>"
            data-notes="<%= description || 'No notes yet.' %>"
            style="--task-color: <%= priorityColor[t.priority] || priorityColor.medium %>"
          >
            <input
              class="task-checkbox"
              type="checkbox"
              <%= t.status === "completed" ? "checked" : "" %>
              data-task-toggle
              aria-label="Toggle complete"
            />
            <div class="task-main">
              <div class="task-title"><%= t.title %></div>
              <div class="task-meta">
                <span><%= dueLabel %></span>
                <span>Due <%= dueLabel %></span>
                <span>Priority: <%= t.priority || 'medium' %></span>
              </div>
            </div>
            <div class="task-actions">
              <button class="glass-btn task-edit-trigger" type="button" data-task-edit>Edit</button>
              <button class="glass-btn" type="button" data-task-delete>Delete</button>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div class="task-detail-drawer" id="task-detail-drawer" aria-hidden="true">
    <div class="task-drawer-header">
      <div>
        <p class="hero-kicker">Task detail</p>
        <h3 id="task-detail-title">Select a task</h3>
      </div>
      <button class="glass-btn" type="button" data-close-drawer>Close</button>
    </div>
    <div class="task-drawer-body">
      <div class="drawer-meta-row">
        <span class="drawer-pill" id="task-detail-priority">Priority</span>
        <span class="drawer-pill" id="task-detail-due">Due</span>
      </div>
      <p id="task-detail-description" class="drawer-description">Pick a task card to open its detail view.</p>
      <div class="drawer-section">
        <h4>Study notes</h4>
        <p id="task-detail-notes">No notes yet.</p>
      </div>
      <div class="drawer-section">
        <h4>Suggested next step</h4>
        <p>Break this task into one small action and keep the momentum going.</p>
      </div>
    </div>
  </div>

  <div class="task-detail-drawer" id="new-task-drawer" aria-hidden="true">
    <div class="task-drawer-header">
      <div>
        <p class="hero-kicker">New task</p>
        <h3>Create a task</h3>
      </div>
      <button class="glass-btn" type="button" data-close-new-task>Close</button>
    </div>
    <div class="task-drawer-body">
      <form id="new-task-form">
        <div class="drawer-section">
          <label for="new-task-title">Title</label>
          <input id="new-task-title" type="text" name="title" required maxlength="200" placeholder="e.g. Finish CA2" />
        </div>
        <div class="drawer-section">
          <label for="new-task-description">Description</label>
          <textarea id="new-task-description" name="description" rows="3" placeholder="Optional notes"></textarea>
        </div>
        <div class="drawer-section">
          <label for="new-task-due">Due date</label>
          <input id="new-task-due" type="date" name="dueDate" />
        </div>
        <div class="drawer-section">
          <label for="new-task-priority">Priority</label>
          <select id="new-task-priority" name="priority">
            <option value="low">Low</option>
            <option value="medium" selected>Medium</option>
            <option value="high">High</option>
          </select>
        </div>
        <button class="glass-btn" type="submit">Create task</button>
      </form>
    </div>
  </div>
</section>

<script src="/js/api.js" defer></script>
<script src="/js/tasks-ui.js" defer></script>