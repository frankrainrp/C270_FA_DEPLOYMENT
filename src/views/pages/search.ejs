<%
  /*
    pages/search.ejs
    Displays search results from MongoDB.
  */

  const searchQuery = typeof query !== "undefined" ? query : "";

  const searchResults =
    typeof results !== "undefined"
      ? results
      : {
          notes: [],
          tasks: [],
          chats: [],
        };

  const totalResults =
    searchResults.notes.length +
    searchResults.tasks.length +
    searchResults.chats.length;

  // Wraps the matched query substring in <mark> so results don't all
  // read as identical blocks of text.
  function highlight(text) {
    if (!text) return "";
    if (!searchQuery) return text;
    const escaped = searchQuery.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    return text.replace(new RegExp(`(${escaped})`, "ig"), "<mark>$1</mark>");
  }
%>

<section class="search-panel">

  <header
    class="chat-composer"
    style="border-top:0;border-bottom:1px solid var(--color-border-soft, #e4ddc9);padding:18px 22px;"
  >
    <h1 style="margin:0;font-size:24px;">Search</h1>

    <% if (searchQuery) { %>
      <p style="margin-top:8px;color:var(--color-text-muted, #8a8370);">
        <strong><%= totalResults %></strong>
        result<%= totalResults === 1 ? "" : "s" %> found for
        "<strong><%= searchQuery %></strong>"
      </p>
    <% } %>
  </header>

  <% if (!searchQuery) { %>

    <div class="search-empty">
      <h2>Start searching</h2>
      <p>Search across all your Notes, Tasks and Chat history.</p>
    </div>

  <% } else if (totalResults === 0) { %>

    <div class="search-empty">
      <h2>No results found</h2>
      <p>Nothing matched "<strong><%= searchQuery %></strong>"</p>
      <p style="margin-top:20px;">Try searching for:</p>
      <ul>
        <li>Task names</li>
        <li>Note titles</li>
        <li>Words inside notes</li>
        <li>Chat messages</li>
      </ul>
    </div>

  <% } else { %>

    <div class="search-results-scroll">

    <% if (searchResults.notes.length) { %>
      <section class="search-group search-group--notes">
        <h2 class="search-group__title">
          Notes
          <span class="search-group__count"><%= searchResults.notes.length %></span>
        </h2>

        <div class="search-list">
          <% searchResults.notes.forEach(note => { %>
            <a class="search-item" href="/notes/<%= note.id %>">
              <h3 class="search-item__title"><%- highlight(note.title) %></h3>
              <p class="search-item__preview"><%- highlight(note.preview) %></p>
              <span class="search-item__meta">Updated <%= note.updated %></span>
            </a>
          <% }) %>
        </div>
      </section>
    <% } %>

    <% if (searchResults.tasks.length) { %>
      <section class="search-group search-group--tasks">
        <h2 class="search-group__title">
          Tasks
          <span class="search-group__count"><%= searchResults.tasks.length %></span>
        </h2>

        <div class="search-list">
          <% searchResults.tasks.forEach(task => { %>
            <a class="search-item" href="/tasks/<%= task.id %>">
              <h3 class="search-item__title"><%- highlight(task.title) %></h3>
              <% if (task.description) { %>
                <p class="search-item__preview"><%- highlight(task.description) %></p>
              <% } %>
              <span class="search-item__tags">
                <% if (task.due) { %><span class="tag tag--due">Due <%= task.due %></span><% } %>
                <% if (task.priority) { %>
                  <span class="tag tag--priority tag--priority-<%= String(task.priority).toLowerCase() %>">
                    <%= task.priority %>
                  </span>
                <% } %>
              </span>
            </a>
          <% }) %>
        </div>
      </section>
    <% } %>

    <% if (searchResults.chats.length) { %>
      <section class="search-group search-group--chats">
        <h2 class="search-group__title">
          Chats
          <span class="search-group__count"><%= searchResults.chats.length %></span>
        </h2>

        <div class="search-list">
          <% searchResults.chats.forEach(chat => { %>
            <a class="search-item" href="/chat/<%= chat.id %>">
              <h3 class="search-item__title"><%- highlight(chat.title) %></h3>
              <% if (chat.snippet) { %>
                <p class="search-item__preview"><%- highlight(chat.snippet) %></p>
              <% } %>
              <span class="search-item__meta">
                <% if (chat.updated) { %>Last active <%= chat.updated %><% } else { %>Conversation<% } %>
              </span>
            </a>
          <% }) %>
        </div>
      </section>
    <% } %>

    </div>

  <% } %>

</section>

<style>
  .search-group {
    padding: 20px 22px;
    border-bottom: 1px solid var(--color-border-soft, #e4ddc9);
  }

  .search-group__title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 14px;
    font-size: 15px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-text-muted, #8a8370);
  }

  .search-group__count {
    margin-left: 2px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-muted, #8a8370);
    background: rgba(0, 0, 0, 0.05);
    border-radius: 999px;
    padding: 1px 8px;
  }

  .search-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .search-item {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--color-surface, #fff);
    border: 1px solid var(--color-border-soft, #e4ddc9);
    border-left: 3px solid var(--accent, #b8ae8c);
    border-radius: 10px;
    padding: 12px 16px;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  .search-item:hover {
    transform: translateX(2px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .search-group--notes .search-item { --accent: #6f9ceb; }
  .search-group--tasks .search-item { --accent: #6fbf73; }
  .search-group--chats .search-item { --accent: #b07fd6; }

  .search-item__title {
    margin: 0 0 4px;
    font-size: 16px;
  }

  .search-item__preview {
    margin: 0 0 6px;
    font-size: 14px;
    color: var(--color-text-muted, #8a8370);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .search-item__meta {
    font-size: 12px;
    color: var(--color-text-muted, #8a8370);
  }

  .search-item__tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.05);
    color: var(--color-text-muted, #8a8370);
  }

  .tag--priority-high { background: #fdeaea; color: #c04a4a; }
  .tag--priority-medium { background: #fdf3e3; color: #b8823a; }
  .tag--priority-low { background: #e9f5ea; color: #3f8f4a; }

  mark {
    background: #fff2a8;
    color: inherit;
    padding: 0 1px;
    border-radius: 2px;
  }

  .search-results-scroll {
    max-height: calc(100vh - 260px);
    overflow-y: auto;
    padding-right: 4px;
  }

  .search-results-scroll::-webkit-scrollbar {
    width: 8px;
  }

  .search-results-scroll::-webkit-scrollbar-thumb {
    background: var(--color-border-soft, #e4ddc9);
    border-radius: 999px;
  }

  /* Quick filter support: sidebar JS sets data-search-filter on <body>.
     Hide non-matching result groups when a specific type is selected. */
  body[data-search-filter="notes"] .search-group:not(.search-group--notes),
  body[data-search-filter="tasks"] .search-group:not(.search-group--tasks),
  body[data-search-filter="chats"] .search-group:not(.search-group--chats) {
    display: none;
  }
</style>