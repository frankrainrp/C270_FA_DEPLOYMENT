<%
  /*
    pages/calendar.ejs
    Calendar month grid.  Events are loaded server-side by pages.js
    from MongoDB and overlaid onto the current month's grid.

    Locals available (via pageLocals):
    - events : Array of CalendarEvent documents (POJOs)
  */
  const events = Array.isArray(locals.events) ? locals.events : [];
  const today = new Date();
  const year = today.getFullYear();
  const month = today.getMonth();
  const monthLabel = today.toLocaleDateString("en", { month: "long", year: "numeric" });

  const weekdays = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
  const daysInMonth = new Date(year, month + 1, 0).getDate();
  const firstDayJs = new Date(year, month, 1).getDay(); // 0 = Sunday
  const leading = (firstDayJs + 6) % 7; // shift so Monday is column 0

  // Group events by ISO date (YYYY-MM-DD) for O(1) lookup per cell.
  const byDate = {};
  events.forEach(function(e) {
    if (!e.date) return;
    const dt = new Date(e.date);
    if (isNaN(dt.getTime())) return;
    const key = dt.getFullYear() + "-" +
                String(dt.getMonth() + 1).padStart(2, "0") + "-" +
                String(dt.getDate()).padStart(2, "0");
    (byDate[key] = byDate[key] || []).push(e);
  });

  const cells = [];
  for (let i = 0; i < leading; i += 1) {
    cells.push({ label: "", muted: true, empty: true, events: [] });
  }
  for (let d = 1; d <= daysInMonth; d += 1) {
    const iso = year + "-" + String(month + 1).padStart(2, "0") + "-" + String(d).padStart(2, "0");
    cells.push({
      label: String(d),
      isToday: d === today.getDate(),
      iso: iso,
      events: byDate[iso] || [],
    });
  }
  while (cells.length % 7 !== 0) {
    cells.push({ label: "", muted: true, empty: true, events: [] });
  }
%>

<section class="calendar-panel" data-calendar-root>
  <header class="calendar-toolbar">
    <strong style="font-family: var(--font-display); font-size: 20px;"><%= monthLabel %></strong>
    <div style="display: flex; gap: 8px; align-items: center;">
      <span style="color: var(--color-text-muted);">
        <%= events.length %> event<%= events.length === 1 ? "" : "s" %>
      </span>
      <button class="glass-btn" type="button" data-refresh-calendar>Refresh</button>
    </div>
  </header>

  <div
    style="display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); padding: 0 18px; color: var(--color-text-muted); font-size: 12px; font-weight: 700;"
  >
    <% weekdays.forEach(function(d) { %>
      <div style="padding: 6px 4px;"><%= d %></div>
    <% }) %>
  </div>

  <div class="calendar-grid">
    <% cells.forEach(function(c) { %>
      <div class="calendar-day <%= c.isToday ? 'today' : '' %> <%= c.muted ? 'muted' : '' %>">
        <span class="calendar-day-number"><%= c.label %></span>

        <% (c.events || []).slice(0, 3).forEach(function(ev) { %>
          <span
            class="calendar-event-chip"
            title="<%= ev.title %>"
            style="display:block; font-size:11px; padding:2px 6px; margin-top:3px; border-radius:4px; background: rgba(74,124,153,0.15); color: var(--color-text); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
          ><%= ev.title %></span>
        <% }) %>

        <% if (c.events && c.events.length > 3) { %>
          <span style="display:block; font-size:10px; color: var(--color-text-muted); margin-top:2px;">
            +<%= c.events.length - 3 %> more
          </span>
        <% } %>
      </div>
    <% }) %>
  </div>
</section>

<script src="/js/api.js" defer></script>
<script src="/js/calendar-ui.js" defer></script>
