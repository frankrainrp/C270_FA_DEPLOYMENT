<%
  /*
    pages/calendar.ejs
    Calendar workspace with a month grid, event pills, and a detail panel
    for the selected day.
    Event data comes from MongoDB via pages.js.
  */
  const events = Array.isArray(locals.events) ? locals.events : [];
  const today = new Date();
  const year = Number.isInteger(Number(locals.calendarYear)) ? Number(locals.calendarYear) : today.getFullYear();
  const month = Number.isInteger(Number(locals.calendarMonth)) ? Number(locals.calendarMonth) : today.getMonth();
  const selectedDateObj = new Date(year, month, 1);
  const monthLabel = selectedDateObj.toLocaleDateString("en", { month: "long", year: "numeric" });
  
  // Weekday header labels shown above the grid.
  const weekdays = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
  const daysInMonth = new Date(year, month + 1, 0).getDate();
  const firstDayJs = new Date(year, month, 1).getDay(); // 0 = Sunday
  const leading = (firstDayJs + 6) % 7; // shift so Monday is column 0

  const colorVar = {
    red: "var(--color-danger)",
    orange: "var(--color-warning)",
    yellow: "var(--color-warning)",
    green: "var(--color-success, #3d8b6e)",
    blue: "var(--color-primary)",
    purple: "var(--color-accent)",
    gray: "var(--color-text-muted)",
  };

  // Group events by ISO date (YYYY-MM-DD) for O(1) lookup per cell.
  const byDate = {};
  events.forEach(function(e) {
    if (!e.date) return;
    const dt = new Date(e.date);
    if (isNaN(dt.getTime())) return;
    const key = dt.getFullYear() + "-" +
                String(dt.getMonth() + 1).padStart(2, "0") + "-" +
                String(dt.getDate()).padStart(2, "0");
    (byDate[key] = byDate[key] || []).push(e);
  });

  const cells = [];
  for (let i = 0; i < leading; i += 1) {
    cells.push({ label: "", muted: true, empty: true, events: [] });
  }
  for (let d = 1; d <= daysInMonth; d += 1) {
    const iso = year + "-" + String(month + 1).padStart(2, "0") + "-" + String(d).padStart(2, "0");
    cells.push({
      label: String(d),
      isToday: d === today.getDate(),
      iso: iso,
      events: byDate[iso] || [],
    });
  }
  while (cells.length % 7 !== 0) {
    cells.push({ label: "", muted: true, empty: true, events: [] });
  }

  const firstEventCell = cells.find((cell) => Array.isArray(cell.events) && cell.events.length > 0);
  const selectedDay = firstEventCell && firstEventCell.label ? Number(firstEventCell.label) : 1;
  const selectedIso = year + "-" + String(month + 1).padStart(2, "0") + "-" + String(selectedDay).padStart(2, "0");
  const selectedEvents = byDate[selectedIso] || [];
  const selectedDate = selectedEvents[0]
    ? { day: selectedDay, title: selectedEvents[0].title, detail: selectedEvents[0].description || "No details yet." }
    : { day: selectedDay, title: "No plans", detail: "Open a day to review its plan." };

  const prevMonth = month === 0 ? 11 : month - 1;
  const prevYear = month === 0 ? year - 1 : year;
  const nextMonth = month === 11 ? 0 : month + 1;
  const nextYear = month === 11 ? year + 1 : year;
%>

<section class="calendar-panel" data-calendar-root data-calendar-year="<%= year %>" data-calendar-month="<%= month %>">
  <header class="calendar-toolbar">
    <div class="calendar-toolbar-row calendar-toolbar-navigation">
      <span class="calendar-toolbar-label">Browse month</span>
      <div class="calendar-month-navigation" aria-label="Calendar month navigation">
        <button
          class="glass-btn calendar-nav-button"
          type="button"
          aria-label="Previous month"
          data-calendar-prev
          data-calendar-target-year="<%= prevYear %>"
          data-calendar-target-month="<%= prevMonth %>"
        >
          <span aria-hidden="true">←</span>
          <span>Previous</span>
        </button>
        <strong class="calendar-month-label" data-calendar-month-label><%= monthLabel %></strong>
        <button
          class="glass-btn calendar-nav-button"
          type="button"
          aria-label="Next month"
          data-calendar-next
          data-calendar-target-year="<%= nextYear %>"
          data-calendar-target-month="<%= nextMonth %>"
        >
          <span>Next</span>
          <span aria-hidden="true">→</span>
        </button>
      </div>
      <button class="glass-btn calendar-today-button" type="button" data-calendar-today>Today</button>
    </div>

    <div class="calendar-toolbar-row calendar-toolbar-events">
      <div class="calendar-event-count">
        <span>Events</span>
        <strong data-calendar-event-count><%= events.length %></strong>
      </div>
      <div class="calendar-toolbar-event-actions">
        <button class="glass-btn glass-btn-primary calendar-new-event-button" type="button" data-calendar-new-event data-action="new-event">New event</button>
        <button class="glass-btn" type="button" data-refresh-calendar>Refresh events</button>
      </div>
    </div>
  </header>

  <div class="calendar-summary calendar-summary--selected">
    <div class="hero-card calendar-selected-day">
      <p class="hero-kicker">Selected day</p>
      <div class="chip-list" data-calendar-selected-chip-list>
        <% if (selectedEvents.length === 0) { %>
          <span class="calendar-chip">Free day</span>
        <% } else { %>
          <% selectedEvents.slice(0, 3).forEach(function(ev) { %>
            <span class="calendar-chip"><%= ev.title %></span>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); padding: 0 18px; color: var(--color-text-muted); font-size: 12px; font-weight: 700;">
    <% weekdays.forEach(function(day) { %>
      <div style="padding: 6px 4px;"><%= day %></div>
    <% }) %>
  </div>

  <div class="calendar-grid" data-calendar-grid>
    <% cells.forEach(function(c) {
      const first = (c.events && c.events[0]) || null;
      const detailTitle = first ? first.title : (c.empty ? "" : "Free day");
      const detailText = first
        ? (first.description || "No details yet.")
        : (c.empty ? "" : "Open space for revision and reflection.");
    %>
      <button
        class="calendar-day <%= c.isToday ? 'today' : '' %> <%= c.muted ? 'muted' : '' %>"
        type="button"
        data-day="<%= c.label %>"
        data-title="<%= detailTitle %>"
        data-detail="<%= detailText %>"
        <% if (c.empty) { %>disabled<% } %>
      >
        <span class="calendar-day-number"><%= c.label %></span>
        <% if (c.events && c.events.length) { %>
          <div class="event-list">
            <% c.events.slice(0, 3).forEach(function(ev) { %>
              <span class="event-pill" style="--event-color: <%= colorVar[ev.color] || colorVar.blue %>">
                <% if (ev.isTask) { %><span class="event-pill-badge">Task</span><% } %>
                <span><%= ev.title %></span>
              </span>
            <% }) %>
          </div>
        <% } %>
      </button>
    <% }) %>
  </div>

  <div class="calendar-detail-card" id="calendar-detail-card">
    <div>
      <p class="hero-kicker">Selected day</p>
      <h3 id="calendar-detail-title" data-calendar-detail-title>Day <%= selectedDate.day %></h3>
      <p id="calendar-detail-detail" data-calendar-detail-text><%= selectedDate.detail %></p>
    </div>
    <div class="calendar-detail-badge" id="calendar-detail-badge" data-calendar-detail-badge><%= selectedDate.title %></div>
  </div>
</section>

<script src="/js/api.js" defer></script>
<script src="/js/calendar-ui.js" defer></script>
