<div class="study-grid">
  <div class="tasks-panel">
    <h3>📝 Active Tasks</h3>
    <ul>
      <% tasks.forEach(function(task) { %>
        <li><input type="checkbox" <%= task.completed ? 'checked' : '' %>> <%= task.title %></li>
      <% }); %>
    </ul>
  </div>
  <div class="calendar-panel">
    <h3>📅 Daily Overview</h3>
    <p>Document parser OCR testing scheduled for 14:00.</p>
  </div>
</div>