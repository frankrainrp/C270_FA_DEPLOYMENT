# -----------------------------------------------------------------
# .env.example
#
# Copy this file to `.env` and fill in the values.  The real .env is
# gitignored so your keys never end up in the repository.
#
# Without DEEPSEEK_API_KEY the chat endpoint returns a deterministic
# mock stream.  Tool-calling (the AI writing to MongoDB) ONLY works
# when a real API key is set — the mock stream never emits tool_calls.
# -----------------------------------------------------------------

# HTTP port for the Express server.
PORT=3000

# Environment mode.  Set to "production" only when deploying.
NODE_ENV=development

# DeepSeek API key.
# Get one at: https://platform.deepseek.com/api_keys
# Leave empty to run in mock mode (chat works, but AI cannot touch DB).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Force deterministic offline responses even when a key is configured.
CHAT_MOCK_MODE=false

# MongoDB connection string.
# Docker compose default (authenticated): mongodb://butler:butler-local-password@localhost:27017/butler?authSource=admin
# Plain local install default:            mongodb://localhost:27017/butler
MONGO_URI=mongodb://butler:butler-local-password@localhost:27017/butler?authSource=admin
MONGO_CONNECT_TIMEOUT_MS=5000

# MongoDB Docker settings. Change the password outside local development.
MONGO_ROOT_USERNAME=butler
MONGO_ROOT_PASSWORD=butler-local-password
MONGO_DATABASE=butler
MONGO_PORT=27017

# Document upload and extracted-text limits (used by the document/OCR
# import feature).
DOCUMENT_MAX_MB=10
DOCUMENT_TEXT_LIMIT=60000

# -----------------------------------------------------------------
# Login: email OTP via n8n
#
# The n8n workflow generates a 6-digit code, emails it via SMTP, and
# returns the code in its response body. Butler's backend (never the
# browser) calls this webhook, holds onto the code server-side, and
# verifies it itself when the user submits the code — see
# services/AuthService.js.
# -----------------------------------------------------------------
N8N_OTP_WEBHOOK_URL=https://n8ngc.codeblazar.org/webhook/send-otp

# How long an emailed code stays valid, in minutes.
OTP_TTL_MINUTES=5

# How many wrong attempts are allowed before the code is invalidated.
OTP_MAX_ATTEMPTS=5

# How long a server-side MongoDB session remains valid.
SESSION_TTL_DAYS=30

# Name of the httpOnly cookie that carries the opaque session token.
SESSION_COOKIE_NAME=butler_session

# Set false only for isolated local UI work. Account-owned routes still
# require a session because they need an owner email.
AUTH_REQUIRED=true
