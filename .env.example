# Copy this file to .env. Never commit the real .env file.

# Web application
PORT=3000
NODE_ENV=development
# DeepSeek (OpenAI-compatible API). Leave the key empty for local mock chat.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Force deterministic offline responses even when a key is configured.
CHAT_MOCK_MODE=false

# Local Node.js -> database-only Compose connection.
MONGO_URI=mongodb://butler:butler-local-password@localhost:27017/butler?authSource=admin
MONGO_CONNECT_TIMEOUT_MS=5000

# MongoDB Docker settings. Change the password outside local development.
MONGO_ROOT_USERNAME=butler
MONGO_ROOT_PASSWORD=butler-local-password
MONGO_DATABASE=butler
MONGO_PORT=27017

# Document upload and extracted-text limits.
DOCUMENT_MAX_MB=10
DOCUMENT_TEXT_LIMIT=60000

# Email + OTP login (see src/services/AuthService.js).
# Production URL from the n8n Webhook node on the "send-otp" workflow.
N8N_OTP_WEBHOOK_URL=
OTP_TTL_MINUTES=5
SESSION_TTL_DAYS=30
SESSION_COOKIE_NAME=butler_session
# Set to false only during local development of OTHER pages if the
# n8n webhook isn't configured yet and you need to bypass the login
# redirect. Keep this true for the real submission/demo.
AUTH_REQUIRED=true
